// ---------- Parser PDF ----------
// Ruta a pdftotext. Dejar 'pdftotext' si está en PATH del server.
define('PDFTOTEXT_BIN', 'pdftotext');

// ---------- Gemini API (escaneo de clientes con IA + parser PDF fallback) ----------
// Obtener en https://aistudio.google.com/app/apikey
// Si queda vacío, el escaneo degrada a "captura manual" (UI permite llenar a mano).
define('GEMINI_API_KEY',   '');   // Key primaria (cuenta principal)
// Key de contingencia: se usa automáticamente cuando la primaria devuelve 503/429/500.
// Crear con una segunda cuenta de Google para tener cuota independiente.
// Dejar vacío si no se tiene segunda cuenta.
define('GEMINI_API_KEY_2', '');   // Key de fallback (segunda cuenta)
// Modelo principal. Si no existe, el cliente cae automáticamente a 2.0-flash → 2.5-flash-lite.
// gemini-1.5-* fue DEPRECADO por Google en 2025, no lo uses.
define('GEMINI_MODEL',     'gemini-2.5-flash');

// ---------- SSH a Hostgator (para el sync Maildir PeonyInc) ----------
// En prod NO hay SSH desde la app (el sync corre directamente en Hostgator leyendo
// ~/mail/valkamgm.com/info/cur/ con PHP). Estas constantes son para el import CLI
// cuando se ejecute desde máquinas remotas.
// IMPORTANTE: en Hostgator bajo Apache/mod_php, getenv('HOME') y $_SERVER['HOME']
// están VACÍOS. Derivar desde __DIR__ (padre de este archivo = home de la cuenta cPanel).
define('MAIL_ROOT', dirname(__DIR__) . '/mail/valkamgm.com/info');
define('PEONY_FROM', 'info@peonyinc.com');

// ---------- LME Prices — Matriz de 4 puntos (F7+) ----------
//
// FUENTE PRIMARIA: NASDAQ Data Link (data.nasdaq.com)
//   Datos diarios LME: Cash Buyer, Cash Seller, 3 Months Buyer, 3 Months Seller.
//   Obtener clave gratuita en: https://data.nasdaq.com/sign-up
//   Limite: 50 req/día gratis. Dataset: LME/PR_CU y LME/PR_AL.
//   Si está configurado, tiene prioridad sobre Alpha Vantage.
define('NASDAQ_API_KEY', '');  // pegar la API key de data.nasdaq.com

// FUENTE FALLBACK: Alpha Vantage (alphavantage.co)
//   Promedio mensual LME (IMF Primary Commodity Prices). Menos preciso que NASDAQ
//   pero útil cuando NASDAQ no está configurado o falla. 25 req/día gratis.
//   Con NASDAQ activo, Alpha Vantage solo se usa si NASDAQ falla completamente.
define('ALPHAVANTAGE_API_KEY', '');  // pegar la API key de alphavantage.co

